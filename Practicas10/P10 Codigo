void Timer1_Init(){
    T1CON = 0b00110001; //Bit 4-5 Preescaler el Bit 0 lo activa
    TMR1H = 0x9E; // 65536 Separamos parte H y L
    TMR1L = 0x58;
    
    TMR1IF = 0; //Bandera
    TMR1IE = 1; //Habilita la interrupcion
    GIE = 1;
    PEIE= 1;
}

void ADC_Init(){ 
    ANSEL = 0X01; 
    ADCON0 = 0X81; 
    ADCON1 = 0X80; 
} 
unsigned int ADC_Read(){
    __delay_us(5); 
   GO_nDONE = 1; 
   while(GO_nDONE); 
   return((ADRESH<<8)+ ADRESL); 
} 

void __interrupt() ISR(void){
    if(TMR1IF){
        contador++;
        if (contador>10){
            tiempo++;
            contador = 0;
        }
                TMR1H = 0x9E;
                TMR1L = 0x58;
                TMR1IF = 0;
    }

}
