void Timer1_Init(){
    T1CON = 0b00110001; // TMR1CS(B1) TMR1CS(B2) T1CKPS1 T1CKPS0 T1OSCEN 'T1SYNC X TMR1ON
    TMR1 = 65536 - 5000; //20ms
    TMR1IE = 1;
    TMR1IF = 0;
    PEIE = 1;
    GIE = 1;
}

void __interrupt() ISR(void){
    if(TMR1IF){
        TMR1IF = 0;
        if(state == 0){
            RD0 = 1;
            RD1 = 0;
            TMR1 = 65536 - pulso1;
            state = 1;
        }
        else if (state == 1){
            RD0 = 0;
            RD1 = 1;
            TMR1 = 65536 - pulso2;
            state = 2;
        }
        else {
            RD0 = 0;
            RD1 = 0;
            TMR1 = 65536 - (5000 - pulso1 - pulso2);
            state = 0;
        }
    }
}

void movserv(char numserv, int ang){
    unsigned int pulsonuevo = 150 +((unsigned long)ang * 450) / 180;
    GIE = 0;
    if(numserv==1){
        pulso1 = pulsonuevo;
    }
    if(numserv==2){
        pulso2 = pulsonuevo;
    }
    GIE = 1;
}

